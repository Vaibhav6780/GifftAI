# Copy to .env and fill in real values for your environment.

NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173

DATABASE_URL="postgresql://gifftai:gifftai_dev_password@localhost:5432/gifftai_crm?schema=public"
REDIS_URL="redis://localhost:6379"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-random-32+-character-secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
RESET_TOKEN_EXPIRES_IN_MINUTES=30

COOKIE_DOMAIN=

# Public IP(s) of your office network(s), comma-separated. Used by the Presence/Attendance
# system to distinguish Office from Remote. Leave blank in an environment with no fixed
# office IP — nobody will ever show as "Online" until this is set. For local dev, try
# "127.0.0.1,::1" to exercise the Office path.
OFFICE_PUBLIC_IPS=

# 24-hour "HH:mm" IST time the one-time Overtime Extension ("Extend Hours" button) extends
# an open session's exit time to. Fixed/admin-configured, not chosen by the employee.
OVERTIME_EXTENSION_TIME=20:00

# Dev default targets the Mailhog container (docker/docker-compose.yml).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="GifftAI CRM <no-reply@gifftai-crm.local>"
SMTP_SECURE=false

# Reserved for the Documents/Attachments phases — MinIO dev credentials from
# docker/docker-compose.yml. Not read by the app yet.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=gifftai_minio_admin
S3_SECRET_KEY=gifftai_minio_password
S3_BUCKET=gifftai-crm-dev

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# See LEAD_INGESTION.md for full setup instructions per platform.
TELEGRAM_MODE=webhook

# Instagram Messaging only — WhatsApp uses WaHamster (WAHAMSTER_API_BASE_URL below), not Meta.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# WhatsApp integration backend (WaHamster, not Meta's Graph API). Per-connection API
# key/secret are entered via Settings → Integrations, not here.
WAHAMSTER_API_BASE_URL=https://whatsapp.lotsofcode.in/api/v1

# RM Requests AND Blog / CMS: gifftai_official_web's admin API base + shared service key,
# so this API can call through to its /rm/* endpoints (list + approve/credit/reject/status/
# assign) and its /blog/* endpoints (list/create/update/publish/delete + image upload).
# Blank = both the RM Requests and Blog pages show "not connected". Must match that repo's
# CRM_SERVICE_KEY exactly.
#   • RM Requests additionally needs the acting CRM user's email to resolve to an active
#     gifftai admin/employee there (the two-admin money-movement control).
#   • Blog / CMS does NOT — CRM's own blog:read / blog:manage permissions are the source of
#     truth; the service key authenticates the CRM and gifftai enforces the per-user scope
#     the CRM asserts. X-Actor-Email is audit-only for blog calls.
# For local dev with both stacks running natively, point WEBSITE_ADMIN_API_URL at
# http://localhost:8001/api/v1/admin.
WEBSITE_ADMIN_API_URL=
WEBSITE_ADMIN_SERVICE_KEY=

# Public origin of gifftai.com — used only to turn stored blog image paths
# (/api/v1/blog/media/...) into absolute preview URLs in the Blog admin UI. The default
# is correct for production.
WEBSITE_PUBLIC_URL=https://gifftai.com

# Seeds a fixed Super Admin login instead of a random generated password (dev only).
SEED_SUPER_ADMIN_EMAIL=admin@gifftai-crm.local
SEED_SUPER_ADMIN_PASSWORD=
